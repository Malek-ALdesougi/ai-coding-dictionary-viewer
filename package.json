{
  "name": "ai-dictionary-graph",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive graph + timeline viewer for the AI Coding Dictionary. Builds to one self-contained HTML file.",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:update-visuals": "playwright test visual --update-snapshots"
  },
  "dependencies": {
    "d3": "7.9.0",
    "dompurify": "3.4.17",
    "focus-trap": "8.2.2",
    "fuse.js": "7.5.0",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.3"
  }
}
